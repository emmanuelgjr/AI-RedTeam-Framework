---
// Sample dashboard visualizations for the metrics page. All data is
// illustrative — it shows what a mature AI red team program tracks,
// not measurements from a real program.

const severityColors = {
  critical: '#881337', // accent-800
  high: '#E11D48', // accent-600
  medium: '#D97706', // warn-600
  low: '#64748B', // ink-500
};

// Chart 1 — findings by severity per quarter (stacked columns)
const findingsByQuarter = [
  { label: 'Q1', critical: 2, high: 5, medium: 9, low: 6 },
  { label: 'Q2', critical: 1, high: 7, medium: 11, low: 8 },
  { label: 'Q3', critical: 3, high: 4, medium: 8, low: 10 },
  { label: 'Q4', critical: 1, high: 3, medium: 7, low: 5 },
];
const fbqMax = Math.max(
  ...findingsByQuarter.map((q) => q.critical + q.high + q.medium + q.low)
);
const fbqChart = { w: 440, h: 220, pad: { t: 12, r: 12, b: 28, l: 32 } };
const fbqPlotH = fbqChart.h - fbqChart.pad.t - fbqChart.pad.b;
const fbqPlotW = fbqChart.w - fbqChart.pad.l - fbqChart.pad.r;
const fbqBarW = 48;
const fbqColumns = findingsByQuarter.map((q, i) => {
  const x =
    fbqChart.pad.l + (fbqPlotW / findingsByQuarter.length) * (i + 0.5) - fbqBarW / 2;
  let yCursor = fbqChart.h - fbqChart.pad.b;
  const segments = (['low', 'medium', 'high', 'critical'] as const).map((sev) => {
    const h = (q[sev] / fbqMax) * fbqPlotH;
    yCursor -= h;
    return { sev, x, y: yCursor, h, count: q[sev] };
  });
  return { label: q.label, x, segments };
});
const fbqTicks = [0, 10, 20];

// Chart 2 — median days to close by severity, vs remediation target
const timeToClose = [
  { sev: 'Critical', days: 18, target: 30, color: severityColors.critical },
  { sev: 'High', days: 41, target: 60, color: severityColors.high },
  { sev: 'Medium', days: 78, target: 90, color: severityColors.medium },
  { sev: 'Low', days: 124, target: 180, color: severityColors.low },
];
const ttcMax = 180;
const ttcChart = { w: 440, h: 200, pad: { t: 8, r: 16, b: 24, l: 72 } };
const ttcPlotW = ttcChart.w - ttcChart.pad.l - ttcChart.pad.r;
const ttcRowH = (ttcChart.h - ttcChart.pad.t - ttcChart.pad.b) / timeToClose.length;
const ttcRows = timeToClose.map((row, i) => ({
  ...row,
  y: ttcChart.pad.t + ttcRowH * i + ttcRowH * 0.22,
  barH: ttcRowH * 0.56,
  barW: (row.days / ttcMax) * ttcPlotW,
  targetX: ttcChart.pad.l + (row.target / ttcMax) * ttcPlotW,
}));

// Chart 3 — % of in-scope systems tested, trailing 12 months
const coverageTrend = [
  { label: 'Jul', pct: 22 }, { label: 'Aug', pct: 27 }, { label: 'Sep', pct: 31 },
  { label: 'Oct', pct: 38 }, { label: 'Nov', pct: 42 }, { label: 'Dec', pct: 45 },
  { label: 'Jan', pct: 51 }, { label: 'Feb', pct: 55 }, { label: 'Mar', pct: 62 },
  { label: 'Apr', pct: 66 }, { label: 'May', pct: 71 }, { label: 'Jun', pct: 74 },
];
const covChart = { w: 440, h: 200, pad: { t: 12, r: 12, b: 24, l: 36 } };
const covPlotW = covChart.w - covChart.pad.l - covChart.pad.r;
const covPlotH = covChart.h - covChart.pad.t - covChart.pad.b;
const covPoints = coverageTrend.map((m, i) => ({
  ...m,
  x: covChart.pad.l + (covPlotW / (coverageTrend.length - 1)) * i,
  y: covChart.h - covChart.pad.b - (m.pct / 100) * covPlotH,
}));
const covLine = covPoints.map((p) => `${p.x},${p.y}`).join(' ');
const covArea = `${covChart.pad.l},${covChart.h - covChart.pad.b} ${covLine} ${
  covPoints[covPoints.length - 1].x
},${covChart.h - covChart.pad.b}`;
const covTargetY = covChart.h - covChart.pad.b - (80 / 100) * covPlotH;

// Chart 4 — attack pattern categories exercised in the last 12 months
const patternCoverage = [
  { cat: 'Prompt injection', tested: 6, total: 6 },
  { cat: 'Sensitive data disclosure', tested: 4, total: 5 },
  { cat: 'Model evasion', tested: 3, total: 4 },
  { cat: 'Training data poisoning', tested: 1, total: 3 },
  { cat: 'Supply chain', tested: 2, total: 4 },
  { cat: 'Infrastructure', tested: 2, total: 3 },
];
const pcChart = { w: 440, h: 230, pad: { t: 8, r: 44, b: 8, l: 160 } };
const pcPlotW = pcChart.w - pcChart.pad.l - pcChart.pad.r;
const pcRowH = (pcChart.h - pcChart.pad.t - pcChart.pad.b) / patternCoverage.length;
const pcRows = patternCoverage.map((row, i) => ({
  ...row,
  y: pcChart.pad.t + pcRowH * i + pcRowH * 0.25,
  barH: pcRowH * 0.5,
  trackW: pcPlotW,
  barW: (row.tested / row.total) * pcPlotW,
}));
---

<div class="grid md:grid-cols-2 gap-6">
  <!-- Findings by severity -->
  <figure class="card">
    <figcaption class="flex items-start justify-between gap-3">
      <div>
        <h3 class="text-base font-semibold text-ink-900">Findings by severity, per quarter</h3>
        <p class="mt-1 text-xs text-ink-500">Engagement layer — severity mix shows whether testing depth is improving, not just volume.</p>
      </div>
      <span class="shrink-0 inline-flex items-center rounded bg-ink-100 px-2 py-0.5 text-[11px] font-medium text-ink-600">Sample data</span>
    </figcaption>
    <svg
      viewBox={`0 0 ${fbqChart.w} ${fbqChart.h}`}
      class="mt-4 w-full h-auto"
      role="img"
      aria-label="Stacked bar chart of findings by severity across four quarters, illustrative sample data"
    >
      {fbqTicks.map((t) => {
        const y = fbqChart.h - fbqChart.pad.b - (t / fbqMax) * fbqPlotH;
        return (
          <>
            <line x1={fbqChart.pad.l} y1={y} x2={fbqChart.w - fbqChart.pad.r} y2={y} stroke="#E2E8F0" stroke-width="1" />
            <text x={fbqChart.pad.l - 6} y={y + 3} text-anchor="end" font-size="10" fill="#94A3B8" font-family="JetBrains Mono, monospace">{t}</text>
          </>
        );
      })}
      {fbqColumns.map((col) => (
        <>
          {col.segments.map((s) => (
            <rect x={s.x} y={s.y} width={fbqBarW} height={s.h} fill={severityColors[s.sev]} rx="1" />
          ))}
          <text x={col.x + fbqBarW / 2} y={fbqChart.h - 8} text-anchor="middle" font-size="11" fill="#475569" font-family="JetBrains Mono, monospace">{col.label}</text>
        </>
      ))}
    </svg>
    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-600">
      {Object.entries({ Critical: severityColors.critical, High: severityColors.high, Medium: severityColors.medium, Low: severityColors.low }).map(([name, color]) => (
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-sm" style={`background:${color}`}></span>{name}
        </span>
      ))}
    </div>
  </figure>

  <!-- Time to close -->
  <figure class="card">
    <figcaption class="flex items-start justify-between gap-3">
      <div>
        <h3 class="text-base font-semibold text-ink-900">Median time-to-close vs. target</h3>
        <p class="mt-1 text-xs text-ink-500">Program layer — days from report delivery to verified remediation. Markers show the agreed SLA per severity.</p>
      </div>
      <span class="shrink-0 inline-flex items-center rounded bg-ink-100 px-2 py-0.5 text-[11px] font-medium text-ink-600">Sample data</span>
    </figcaption>
    <svg
      viewBox={`0 0 ${ttcChart.w} ${ttcChart.h}`}
      class="mt-4 w-full h-auto"
      role="img"
      aria-label="Horizontal bar chart of median days to close findings by severity against remediation targets, illustrative sample data"
    >
      {ttcRows.map((row) => (
        <>
          <text x={ttcChart.pad.l - 8} y={row.y + row.barH / 2 + 4} text-anchor="end" font-size="11" fill="#475569">{row.sev}</text>
          <rect x={ttcChart.pad.l} y={row.y} width={ttcPlotW} height={row.barH} fill="#F1F5F9" rx="2" />
          <rect x={ttcChart.pad.l} y={row.y} width={row.barW} height={row.barH} fill={row.color} rx="2" />
          <line x1={row.targetX} y1={row.y - 3} x2={row.targetX} y2={row.y + row.barH + 3} stroke="#0F172A" stroke-width="1.5" stroke-dasharray="2 2" />
          <text x={ttcChart.pad.l + row.barW + 6} y={row.y + row.barH / 2 + 4} font-size="10" fill="#64748B" font-family="JetBrains Mono, monospace">{row.days}d</text>
        </>
      ))}
      <text x={ttcChart.w - ttcChart.pad.r} y={ttcChart.h - 6} text-anchor="end" font-size="10" fill="#94A3B8">dashed line = SLA target</text>
    </svg>
  </figure>

  <!-- Coverage trend -->
  <figure class="card">
    <figcaption class="flex items-start justify-between gap-3">
      <div>
        <h3 class="text-base font-semibold text-ink-900">Coverage of in-scope systems, trailing 12 months</h3>
        <p class="mt-1 text-xs text-ink-500">Board layer — % of in-scope AI systems with at least one adversarial test in the trailing 12 months.</p>
      </div>
      <span class="shrink-0 inline-flex items-center rounded bg-ink-100 px-2 py-0.5 text-[11px] font-medium text-ink-600">Sample data</span>
    </figcaption>
    <svg
      viewBox={`0 0 ${covChart.w} ${covChart.h}`}
      class="mt-4 w-full h-auto"
      role="img"
      aria-label="Line chart of trailing twelve month adversarial testing coverage rising from 22 to 74 percent against an 80 percent target, illustrative sample data"
    >
      {[0, 25, 50, 75, 100].map((t) => {
        const y = covChart.h - covChart.pad.b - (t / 100) * covPlotH;
        return (
          <>
            <line x1={covChart.pad.l} y1={y} x2={covChart.w - covChart.pad.r} y2={y} stroke="#E2E8F0" stroke-width="1" />
            <text x={covChart.pad.l - 6} y={y + 3} text-anchor="end" font-size="10" fill="#94A3B8" font-family="JetBrains Mono, monospace">{t}%</text>
          </>
        );
      })}
      <polygon points={covArea} fill="#9F1239" opacity="0.08" />
      <polyline points={covLine} fill="none" stroke="#9F1239" stroke-width="2" />
      <line x1={covChart.pad.l} y1={covTargetY} x2={covChart.w - covChart.pad.r} y2={covTargetY} stroke="#0F172A" stroke-width="1.5" stroke-dasharray="2 2" />
      <text x={covChart.w - covChart.pad.r} y={covTargetY - 5} text-anchor="end" font-size="10" fill="#475569">target 80%</text>
      {covPoints.filter((_, i) => i % 2 === 0).map((p) => (
        <text x={p.x} y={covChart.h - 8} text-anchor="middle" font-size="10" fill="#94A3B8" font-family="JetBrains Mono, monospace">{p.label}</text>
      ))}
      <circle cx={covPoints[covPoints.length - 1].x} cy={covPoints[covPoints.length - 1].y} r="3" fill="#9F1239" />
    </svg>
  </figure>

  <!-- Pattern category coverage -->
  <figure class="card">
    <figcaption class="flex items-start justify-between gap-3">
      <div>
        <h3 class="text-base font-semibold text-ink-900">Attack-pattern categories exercised</h3>
        <p class="mt-1 text-xs text-ink-500">Program layer — patterns exercised at least once in the last 12 months, by category. Gaps drive next year's engagement plan.</p>
      </div>
      <span class="shrink-0 inline-flex items-center rounded bg-ink-100 px-2 py-0.5 text-[11px] font-medium text-ink-600">Sample data</span>
    </figcaption>
    <svg
      viewBox={`0 0 ${pcChart.w} ${pcChart.h}`}
      class="mt-4 w-full h-auto"
      role="img"
      aria-label="Horizontal bar chart of attack pattern categories exercised in the last twelve months, illustrative sample data"
    >
      {pcRows.map((row) => (
        <>
          <text x={pcChart.pad.l - 8} y={row.y + row.barH / 2 + 4} text-anchor="end" font-size="11" fill="#475569">{row.cat}</text>
          <rect x={pcChart.pad.l} y={row.y} width={row.trackW} height={row.barH} fill="#F1F5F9" rx="2" />
          <rect x={pcChart.pad.l} y={row.y} width={row.barW} height={row.barH} fill="#9F1239" rx="2" />
          <text x={pcChart.pad.l + row.trackW + 6} y={row.y + row.barH / 2 + 4} font-size="10" fill="#64748B" font-family="JetBrains Mono, monospace">{row.tested}/{row.total}</text>
        </>
      ))}
    </svg>
  </figure>
</div>
