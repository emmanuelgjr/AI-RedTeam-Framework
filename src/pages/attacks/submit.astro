---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PatternSubmissionForm from '../../components/PatternSubmission/PatternSubmissionForm.tsx';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const attacks = await getCollection('attacks');
const maxId = attacks
  .map((a) => parseInt(a.data.id.replace('ATK-', ''), 10))
  .reduce((a, b) => Math.max(a, b), 0);
const nextId = `ATK-${String(maxId + 1).padStart(3, '0')}`;
---

<BaseLayout
  title="Submit an Attack Pattern — AI Red Team Framework"
  description="Draft a new attack pattern in the browser and generate a PR-ready content file. Defensively framed, schema-validated."
>
  <section class="max-w-content mx-auto px-6 lg:px-8 py-12">
    <p class="text-sm font-medium text-accent-700">Contribute</p>
    <h1 class="font-display font-semibold text-3xl md:text-4xl tracking-tight text-ink-900 mt-2">
      Submit an attack pattern
    </h1>
    <p class="mt-3 text-ink-600 max-w-prose-wide">
      Fill in the fields below and this page generates a schema-valid content file
      ready to drop into a pull request. Patterns must be framed as
      <em>how to test defenses against</em> a technique — read
      <a href={`${base}ethics`} class="text-accent-700 hover:underline">ETHICS</a> and the
      <a href={`${base}contribute`} class="text-accent-700 hover:underline">contribution quality bar</a>
      first. Field-tested patterns from real engagements are what this library values most.
    </p>

    <div class="mt-10">
      <PatternSubmissionForm client:load nextId={nextId} />
    </div>
  </section>
</BaseLayout>
