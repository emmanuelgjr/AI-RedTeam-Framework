---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((t) => ({ params: { slug: t.data.slug }, props: { tool: t.data } }));
}
const { tool } = Astro.props;
---

<BaseLayout
  title={`${tool.name} — Tool review — AI Red Team Framework`}
  description={tool.what_it_does.slice(0, 160)}
  ogType="article"
>
  <article class="max-w-3xl mx-auto px-6 lg:px-8 py-12">
    <a href="/tools" class="text-sm text-ink-500 hover:text-accent-700">← All tools</a>

    <header class="border-b border-ink-200 pb-8 mt-3 mb-8">
      <p class="text-xs text-ink-500 uppercase tracking-wide">{tool.vendor} · {tool.type}</p>
      <h1 class="font-display font-semibold text-3xl tracking-tight text-ink-900 mt-2">{tool.name}</h1>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tool.category.map((c) => <span class="badge-neutral">{c}</span>)}
      </div>
    </header>

    <div class="prose prose-lg max-w-prose-wide">
      <h2>What it does</h2>
      <p>{tool.what_it_does}</p>
      <h2>What it doesn't do</h2>
      <p>{tool.what_it_doesnt_do}</p>
      <h2>Best for</h2>
      <ul>{tool.best_for.map((b) => <li>{b}</li>)}</ul>
      <h2>Not for</h2>
      <ul>{tool.not_for.map((b) => <li>{b}</li>)}</ul>
      <h2>Pricing</h2>
      <p>{tool.pricing_summary}</p>
      <h2>Integration effort</h2>
      <p>{tool.integration_effort}</p>
      <h2>Team skill required</h2>
      <p>{tool.team_skill_required}</p>
      <p class="text-sm text-ink-500"><a href={tool.url} target="_blank" rel="noopener noreferrer">Vendor / project page →</a></p>
      <p class="text-sm text-ink-500">Last reviewed: {tool.last_reviewed}</p>
    </div>
  </article>
</BaseLayout>
