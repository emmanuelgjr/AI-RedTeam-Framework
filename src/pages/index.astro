---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const attacks = await getCollection('attacks');
const tools = await getCollection('tools');
const playbook = await getCollection('playbook');
---

<BaseLayout
  title="AI Red Team Framework — Stand up an AI red team at a regulated enterprise"
  description="The practitioner playbook + interactive tooling to plan, scope, execute, and report AI red team engagements. Mapped to MITRE ATLAS, OWASP, OSFI, NIST AI RMF."
>
  <section class="max-w-content mx-auto px-6 lg:px-8 pt-16 pb-12">
    <p class="text-sm font-medium text-accent-700">Attack AI</p>
    <h1 class="font-display font-semibold tracking-tight text-4xl md:text-5xl text-ink-900 mt-3 max-w-3xl">
      Stand up an AI red team at a regulated enterprise.
    </h1>
    <p class="mt-5 text-lg text-ink-600 leading-relaxed max-w-3xl">
      A 15-chapter playbook + an interactive Engagement Planner that generates a
      professionally drafted Rules of Engagement in five minutes. Attack pattern
      library mapped to OWASP, MITRE ATLAS, and NIST AI RMF. Honest tool reviews.
      Compliance crosswalk for OSFI E-21 and EU AI Act.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/planner" class="btn btn-primary btn-lg">Try the Engagement Planner →</a>
      <a href="/playbook" class="btn btn-secondary btn-lg">Open the Playbook</a>
    </div>
  </section>

  <section class="max-w-content mx-auto px-6 lg:px-8 py-12 border-t border-ink-100">
    <h2 class="font-display font-semibold text-3xl text-ink-900 tracking-tight">What's inside</h2>
    <div class="grid md:grid-cols-3 gap-6 mt-8">
      <div class="card">
        <p class="text-3xl font-semibold text-accent-700">{attacks.length}</p>
        <h3 class="mt-1 text-lg font-semibold text-ink-900">Attack patterns</h3>
        <p class="mt-2 text-sm text-ink-600">Mapped to OWASP LLM / Agentic Top 10, MITRE ATLAS, NIST AI RMF.</p>
        <a href="/attacks" class="mt-3 inline-block text-sm text-accent-700 font-medium hover:text-accent-800">Browse →</a>
      </div>
      <div class="card">
        <p class="text-3xl font-semibold text-accent-700">{tools.length}</p>
        <h3 class="mt-1 text-lg font-semibold text-ink-900">Tool reviews</h3>
        <p class="mt-2 text-sm text-ink-600">Open source, commercial, AI-augmented BAS. With honest limitations.</p>
        <a href="/tools" class="mt-3 inline-block text-sm text-accent-700 font-medium hover:text-accent-800">Browse →</a>
      </div>
      <div class="card">
        <p class="text-3xl font-semibold text-accent-700">{playbook.length}</p>
        <h3 class="mt-1 text-lg font-semibold text-ink-900">Playbook chapters</h3>
        <p class="mt-2 text-sm text-ink-600">From charter to maturity model. Real-world tone, not academic.</p>
        <a href="/playbook" class="mt-3 inline-block text-sm text-accent-700 font-medium hover:text-accent-800">Open →</a>
      </div>
    </div>
  </section>

  <section class="max-w-content mx-auto px-6 lg:px-8 py-12 border-t border-ink-100">
    <div class="max-w-prose-wide">
      <h2 class="font-display font-semibold text-3xl text-ink-900 tracking-tight">The headline feature</h2>
      <p class="mt-4 text-ink-700 leading-relaxed">
        The <a href="/planner" class="text-accent-700 hover:underline">Engagement Planner</a> is a
        12-step wizard that turns "we need to red-team this" into a 13-section,
        professionally formatted Rules of Engagement document — including a
        tailored attack-pattern selection, tooling recommendations, and a
        compliance traceability section specific to the regulatory regime you
        operate in.
      </p>
      <p class="mt-4 text-ink-700 leading-relaxed">
        All processing is local to your browser. Inputs never leave your machine.
      </p>
    </div>
  </section>
</BaseLayout>
